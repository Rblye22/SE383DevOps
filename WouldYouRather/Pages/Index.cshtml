@page
@model IndexModel
@{
    ViewData["Title"] = "Would You Rather";
}

<h1><br />Would You Rather...</h1>
<div class="Questions">
    <div class="options">
        <div class="option" id="optionA">
            <div id="optionAText">
                <p> Question Option A</p>
            </div>
        </div>
        <div class="or-label">OR</div>
        <div class="option" id="optionB">
            <div id="optionBText">
                <p> Question Option B</p>
            </div>
        </div>
    </div>
    <button class="next-btn" id="nextBtn">Next</button>
</div>

@section Scripts {
    <script src="~/js/index.js"></script>
}